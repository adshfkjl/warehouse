{
  "Jwt": {
    "Issuer": "warehouse-development",
    "Audience": "warehouse-development",
    "SigningKey": "replace-with-a-secret-key-of-at-least-32-characters",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "1.00:00:00"
  },
  "Wms": {
    "DeviceGatewayMode": "Simulator",
    "ExternalIntegrationsEnabled": false,
    "PersistenceMode": "InMemory"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
