<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=YOUR_DB_HOST;Database=StoreHouse;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="HeartbeatInterval" value="1000" />
    <add key="ReadInterval" value="1500" />
    <add key="ReconnectInterval" value="60000" />
    <add key="MaxRetryCount" value="5" />
    <add key="FastReadInterval" value="200" />
    <add key="AutoRunUpdateInterval" value="5000" />
    <add key="PlcConnectTimeout" value="3000" />
    <add key="DbCommandTimeout" value="10" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
