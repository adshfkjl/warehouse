{
  "ConnectionStrings": {
    "StoreHouseConnection": "server=YOUR_DB_HOST;database=Storehouse;uid=YOUR_DB_USER;pwd=YOUR_DB_PASSWORD;TrustServerCertificate=true;Pooling=true;Min Pool Size=5;Max Pool Size=100;Connect Timeout=3;",
    "DB_SDL1": "server=YOUR_DB_HOST;database=DB_SDL1;uid=YOUR_DB_USER;pwd=YOUR_DB_PASSWORD;TrustServerCertificate=true;Pooling=true;Min Pool Size=2;Max Pool Size=50;Connect Timeout=3;"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Transaction": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Default": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "PLCManagement.API"
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET",
    "Issuer": "wms-pda-api",
    "Audience": "wms-pda-client",
    "ExpireMinutes": 120,
    "RefreshExpireDays": 7
  }
}
